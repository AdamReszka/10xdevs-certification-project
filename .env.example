# SprintFlow environment — copy to .env and fill in. NEVER commit real values.
# .env is gitignored; only this placeholder file is tracked.

# --- Supabase (public client config) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Database (server only) ---
# Postgres connection string. NOTE: the Supabase *direct* host
# (db.<ref>.supabase.co) is IPv6-only; from IPv4 networks use the Supavisor
# pooler host (aws-0-<region>.pooler.supabase.com, user postgres.<ref>) for
# drizzle-kit migrate.
DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Local Hyperdrive dev connection (used by `wrangler dev`).
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Token encryption at rest (F-02) ---
# AES-256-GCM key for encrypting GitHub PAT + Jira API tokens before storage.
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes).
# Production: set out-of-band via `wrangler secret put TOKEN_ENCRYPTION_KEY` — a
# Workers *secret*, NOT a `var` in wrangler.jsonc (vars resolve null on this
# OpenNext version; a null key silently breaks every store). Never committed.
TOKEN_ENCRYPTION_KEY=<random-32-byte-base64>

# --- Better Auth (F-01) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=<random-32-byte-base64>
# Base URL Better Auth issues cookies/redirects against, and the source of the
# absolute links in reset/recap emails.
# Local dev: http://localhost:3000 — deployed Worker uses the BETTER_AUTH_URL var.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Comma-separated EXTRA origins Better Auth should trust, on top of the
# ones compiled into src/lib/auth-origins.ts (production, workers.dev, loopback).
# The escape hatch for a new domain without a deploy. Origins are no longer taken
# from BETTER_AUTH_URL alone — see that module for why (2026-09-01 incident).
# BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.com

# --- Email transport (S-11: FR-018 Daily Recap + FR-001 password reset) ---
# Resend API key. Production: `wrangler secret put RESEND_API_KEY` — a Workers
# *secret*, NOT a `var` in wrangler.jsonc (plain vars resolve to null in
# getCloudflareContext().env on this OpenNext version). Leave BOTH unset in local
# dev and the console transport logs the message instead of sending it.
RESEND_API_KEY=<resend-api-key>
# Verified sender, e.g. "SprintFlow <recap@sprintflow.pl>". Also a Workers
# *secret* rather than a var — not because it is sensitive, but for the same
# null-resolution reason above.
RESEND_FROM_ADDRESS=SprintFlow <recap@sprintflow.pl>
# Signing secret for the bounce/complaint webhook (S-12, FR-019). Copy the
# `whsec_…` value from the webhook's page in the Resend panel. Production:
# `wrangler secret put RESEND_WEBHOOK_SECRET` — a Workers *secret*, NOT a `var`
# (same null-resolution reason, and this one is genuinely sensitive: it is the
# only thing authenticating /api/webhooks/resend). Leave it unset in local dev
# and the endpoint answers 500 without touching the database.
RESEND_WEBHOOK_SECRET=whsec_<signing-secret>

# --- Claude / Anthropic (S-13: FR-020 Refinement Helper) ---
# Anthropic API key. Production: `wrangler secret put ANTHROPIC_API_KEY` — a
# Workers *secret*, NOT a `var` in wrangler.jsonc (plain vars resolve to null in
# getCloudflareContext().env on this OpenNext version, and a null key would fail
# every call at runtime while the build stays green). Model is pinned in code
# (`ANTHROPIC_MODEL` in src/lib/anthropic.ts), not here.
# Leave it unset locally and /refinement degrades with a banner and saves
# nothing — it never falls back to a fake verdict.
ANTHROPIC_API_KEY=<anthropic-api-key>
