{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "10xdevs-certification-project",
	// Custom entry (S-05): wraps OpenNext's generated `.open-next/worker.js` fetch
	// handler + DO classes and adds the `scheduled` cron handler below.
	"main": "src/worker.ts",
	// nodejs_compat is required for Better Auth's native node:crypto scrypt path
	// (F-01). compatibility_date must stay 2025+ for the fully-native crypto build.
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// 15-min sync loop (FR-011/012). Fires the `scheduled` handler in src/worker.ts.
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "86417a117a96464e947d5005e56f2a21",
			// SQL RESPONSE CACHING IS DISABLED on this config, set 2026-09-01 with
			// `wrangler hyperdrive update <id> --caching-disabled`. It is recorded
			// here because it lives on Cloudflare's side, not in this repo, and is
			// therefore invisible to anyone reading the code.
			//
			// It was ON by default (~60s), and that made read-after-write return
			// pre-write state in production: the demo door wrote its world and
			// flipped `active_workspace` to DEMO, `/dashboard` then read `REAL`
			// from cache, and the gate bounced the visitor back to the doorstep. A
			// second press re-read a cached empty `findDemoOwner` and tried to
			// insert the same demo owner twice. See `lessons.md`.
			//
			// Do NOT re-enable it. SprintFlow is an interactive per-user dashboard
			// where nearly every action writes and then reads; there is no read
			// volume to amortise a cache against, and every second of staleness is
			// a visible defect. NOTHING LOCAL CAN CATCH A REGRESSION HERE — dev,
			// unit, integration and Playwright all reach Postgres directly.
			// localConnectionString is ONLY used by Miniflare's local Hyperdrive
			// emulation — never in production (the deployed worker connects via the
			// `id` above). It is required because `opennextjs-cloudflare deploy`
			// boots a local platform proxy to read env, and that proxy refuses to
			// construct a Hyperdrive binding with no local connection string,
			// failing the CI deploy before upload. This placeholder satisfies that
			// check; the deploy never opens a connection to it. For real local
			// Hyperdrive testing via `npm run preview`, point this at a Postgres
			// you actually run locally (and keep any real value out of git).
			"localConnectionString": "postgresql://user:password@localhost:5432/db"
		}
	],
	// Public, client-safe Supabase config. NOTE: BETTER_AUTH_SECRET,
	// BETTER_AUTH_URL, RESEND_API_KEY, RESEND_FROM_ADDRESS,
	// ANTHROPIC_API_KEY (S-13, the Refinement Helper) and
	// RESEND_WEBHOOK_SECRET (S-12, the bounce/complaint webhook — the only
	// thing authenticating /api/webhooks/resend) are Workers
	// *secrets* (wrangler secret put), NOT vars —
	// plain vars did not surface in getCloudflareContext().env on this OpenNext
	// version (resolved to null), whereas secrets do. Never put secret values here.
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://uzqwuikgbbkpnemcnlwo.supabase.co",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_lwIhY8exodoHZM-0SjRQEg_6XHX3It-"
	}
}
